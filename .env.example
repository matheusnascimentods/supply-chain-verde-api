# Copie para .env (cp .env.example .env). O .env nunca vai para o Git.
# Lido pelo docker compose e pelo ./mvnw spring-boot:run: KEY=valor, sem export, aspas ou espaços em volta do =.
# Os valores abaixo servem para desenvolvimento. Na VM, gere cada segredo com o comando indicado.

# Senhas do MySQL. Entram numa string SQL no init: use só letras e números.
# Produção: openssl rand -hex 24. Um volume já criado mantém as senhas da criação; para trocar, docker compose down -v.
MYSQL_ROOT_PASSWORD=root
MYSQL_APP_PASSWORD=supply_app

# Chave HMAC dos tokens (mínimo de 32 caracteres). Trocar derruba todas as sessões.
# Gere com: openssl rand -hex 32
JWT_SECRET=

# SendGrid: chave com permissão Mail Send e remetente verificado (README, Quick Start).
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM=noreply@seu-dominio.com

# Domínio público. O Caddy emite o certificado para ele, e o link do convite vira https://<SITE_ADDRESS>.
# Desenvolvimento: localhost (o Caddy usa uma CA local). Produção: o domínio, com o DNS já apontando para a VM.
SITE_ADDRESS=localhost

# Opcional: só para o front em ng serve, fora do compose.
# APP_FRONTEND_URL=http://localhost:4200
